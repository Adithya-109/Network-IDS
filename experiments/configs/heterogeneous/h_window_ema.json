{
  "name": "h_window_ema",
  "description": "Per-window plain EMA with population prior and a 300 s training period (no drift bound).",
  "seed": 42,
  "overrides": {
    "engine": {
      "alert_cooldown": 0,
      "layers": {
        "stealth": false,
        "volumetric": true,
        "suspicious_port": false,
        "dpi": false,
        "ml": false,
        "drift": true
      }
    },
    "dynamic": {
      "adaptive_thresholds": {
        "method": "ema",
        "update": "window",
        "population_prior": true,
        "cold_start": "static",
        "bootstrap_seconds": 300,
        "std_floor": "poisson"
      }
    }
  }
}