{
  "name": "ml_window",
  "description": "Window ML: per-(source, 5 s window) features, batch scoring, threshold calibrated to 1% FPR on held-out clean windows, reservoir buffer, clean training.",
  "seed": 42,
  "overrides": {
    "engine": {
      "alert_cooldown": 0,
      "layers": {
        "stealth": true,
        "volumetric": true,
        "suspicious_port": true,
        "dpi": true,
        "ml": true,
        "drift": true
      }
    },
    "dynamic": {
      "model_learning": {
        "mode": "window",
        "window_seconds": 5,
        "buffer": "reservoir",
        "target_fpr": 0.01,
        "clean_training": true,
        "clean_horizon_seconds": 10,
        "clean_max_reputation": 50,
        "window_size": 1500
      }
    }
  }
}