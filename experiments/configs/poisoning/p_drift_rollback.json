{
  "name": "p_drift_rollback",
  "description": "Drift-bounded baseline; a drift alarm also rolls the baseline back to the reference (rules.json default).",
  "seed": 42,
  "overrides": {
    "engine": {
      "alert_cooldown": 0,
      "layers": {
        "stealth": false,
        "volumetric": true,
        "suspicious_port": false,
        "dpi": false,
        "ml": false,
        "drift": true
      }
    },
    "dynamic": {
      "adaptive_thresholds": {
        "method": "drift_bounded",
        "drift": {
          "rollback": true
        },
        "update": "window",
        "population_prior": true,
        "cold_start": "static",
        "std_floor": "poisson",
        "bootstrap_seconds": 300
      }
    }
  }
}